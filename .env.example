# Perseus Dashboard — Environment Configuration
# Copy to .env and fill in your values.

# AWS Aurora PostgreSQL connection (leave empty to use mock/demo data)
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=

# Vercel deployment (set in Vercel dashboard, not here for production)
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
